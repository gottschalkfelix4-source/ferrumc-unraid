+                tokio::spawn(telemetry::start_telemetry_loop(tx, state.clone()));
+                let app = Router::new().route("/ws", get(ws::ws_handler))
+                    .with_state(ws_state).nest("/api", bridge::router(state));
+                let port = std::env::var("FERRUMC_BRIDGE_PORT").unwrap_or_else(|_| "9001".into());
+                let listener = tokio::net::TcpListener::bind(format!("127.0.0.1:{port}"))
+                    .await.expect("internal dashboard listener");
+                tracing::info!("Internal dashboard bridge ready");
+                axum::serve(listener, app).await.expect("internal dashboard bridge");
+            });
+    }).expect("dashboard thread");
 }
